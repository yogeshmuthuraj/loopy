{
  "name": "loopy",
  "version": "0.1.0",
  "description": "Simple desktop Electron app to browse, search, play, and drag audio loops from a chosen folder.",
  "main": "main.js",
  "productName": "Loopy",
  "license": "MIT",
  "author": "",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dist:mac": "electron-builder --mac",
    "dist:mac:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.loopy.app",
    "productName": "Loopy",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    }
  }
}
